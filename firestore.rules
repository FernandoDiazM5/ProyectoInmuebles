rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAgent() { return isAuth() && role() == 'agent'; }
    function isOwner() { return isAuth() && role() == 'owner'; }
    function isTenant() { return isAuth() && role() == 'tenant'; }

    // ── Usuarios ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow create, delete: if false;
    }

    // ── Propiedades ──────────────────────────────────────────
    match /properties/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAgent() || isOwner();
    }

    // ── Arrendatarios ────────────────────────────────────────
    match /tenants/{id} {
      allow read: if isAgent() || isOwner()
                  || (isTenant() && resource.data.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email);
      allow create, update: if isAgent();
      allow delete: if isOwner();
    }

    // ── Contratos ────────────────────────────────────────────
    match /contracts/{id} {
      allow read: if isAgent() || isOwner();
      allow create, update: if isAgent();
      allow delete: if isOwner();
    }

    // ── Pagos ─────────────────────────────────────────────────
    match /payments/{id} {
      allow read: if isAgent() || isOwner() || isTenant();
      allow create: if isAuth();
      allow update: if isAgent();
      allow delete: if false;
    }

    // ── Recibos ───────────────────────────────────────────────
    match /receipts/{id} {
      allow read: if isAuth();
      allow create, update: if isAgent();
      allow delete: if false;
    }
  }
}
