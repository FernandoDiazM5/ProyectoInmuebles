rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function userDoc() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return d != null ? d.data : null;
    }
    function role() {
      let docData = userDoc();
      return docData != null ? docData.role : 'none';
    }
    function isAdmin()  { return isAuth() && role() == 'admin';  }
    function isAgent()  { return isAuth() && role() == 'agent';  }
    function isOwner()  { return isAuth() && role() == 'owner';  }
    function isTenant() { return isAuth() && role() == 'tenant'; }

    // ── Usuarios ─────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if (isAuth() && request.auth.uid == userId) || isAdmin();
      allow create: if (isAuth() && request.auth.uid == userId) || isAdmin();
      allow update: if (isAuth() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Propiedades ──────────────────────────────────────────
    match /properties/{id} {
      allow read:                    if isAuth();
      allow create, update, delete:  if isAdmin() || isAgent() || isOwner();
    }

    // ── Arrendatarios ────────────────────────────────────────
    match /tenants/{id} {
      allow read:           if isAdmin() || isAgent() || isOwner()
                            || (isTenant() && resource.data.email == userDoc().email);
      allow create, update: if isAdmin() || isAgent();
      allow delete:         if isAdmin() || isAgent() || isOwner();
    }

    // ── Contratos ────────────────────────────────────────────
    match /contracts/{id} {
      allow read:           if isAdmin() || isAgent() || isOwner()
                            || (isTenant()
                                && resource.data.tenantId != null
                                && userDoc().tenantId != null
                                && resource.data.tenantId == userDoc().tenantId);
      allow create, update: if isAdmin() || isAgent();
      allow delete:         if isAdmin() || isAgent() || isOwner();
    }

    // ── Pagos ─────────────────────────────────────────────────
    // La eliminación solo está permitida como parte de operaciones en cascada
    // realizadas por admin o agente; el sistema nunca expone un botón de
    // "eliminar pago" individual en la UI.
    match /payments/{id} {
      allow read:          if isAdmin() || isAgent() || isOwner() || isTenant();
      allow create:        if isAuth();
      allow update:        if isAdmin() || isAgent();
      allow delete:        if isAdmin() || isAgent();
    }
  }
}
