# Plantilla opcional; en desarrollo use `.env` con VITE_FIREBASE_*.
# Correo nuevo arrendatario: plantilla Firebase «restablecer contraseña»; use %EMAIL% en el texto (consola Firebase).
# =============================================

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Opcional (npm run seed:properties): credenciales de un usuario con rol agente
# SEED_AGENT_EMAIL=
# SEED_AGENT_PASSWORD=

# Dirección única de todo el conjunto (mismo edificio/punto para todas las unidades).
# Úsenla en seed:properties si la define aquí; obligatoria para npm run unify:property-addresses
# PROPERTY_SITE_ADDRESS=Torre Parque Sol, Jr. Ejemplo 100, Lima

VITE_APP_ENV=development
